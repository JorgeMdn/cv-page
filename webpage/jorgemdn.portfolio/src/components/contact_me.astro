<section class="row contact_me justify-content-center" id="contact_me">
  <div class="col-md-6 d-flex align-items-center">
    <div class="row">
      <div class="col-md-12">
        <h2 class="blast d-block text-center" aria-label="Contact me">
          Contact me
        </h2>
      </div>
      <div class="col-md-12">
        <h2 class="text-center">Send me a message!</h2>
      </div>
      <div class="col-md-12">
        <p class="text-center contact__message">
          My inbox is always open. Whether you have a question or just want to
          say hi, I’ll try my best to get back to you!
        </p>
      </div>
      <div class="col-md-12 d-flex justify-content-center">
        <a
          class="button button__contained mt-0 pb"
          href="mailto:jorge.medina.dev@gmail.com"
        >
          Say hello
        </a>
      </div>
    </div>
  </div>
