<!-- CONTACT_ME START -->
<section class="contact_me" id="contact_me">
  <img
    src="./assets/icons/waves_up.svg"
    alt="backgroud waves up"
    class="contact_me__bg"
  />
  <div class="contact_me__content">
    <div class="row">
      <div class="col-md-12">
        <div class="row">
          <div class="col-md-12">
            <h2 class="blast d-block text-center" aria-label="Contact me">
              Contact me
              <span class="d-inline-block pl-2"
                ><i class="fa fa-hand-peace-o fa-lg"></i></span
              >
            </h2>
          </div>
          <div class="col-md-12">
            <h2 class="text-center pb-2">Send me a message!</h2>
          </div>
          <div class="col-md-12">
            <p class="text-center contact__message">
              My inbox is always open. Whether you have a question or just want
              to say hi, I’ll try my best to get back to you!
            </p>
          </div>
          <div class="col-md-12 d-flex justify-content-center">
            <a
              class="button button__contained mt-0 pb contact__btn"
              href="mailto:jorge.medina.dev@gmail.com"
            >
              Say hello
              <span class="d-inline-block pl-2"
                ><i class="fa fa-envelope fa-lg"></i></span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- CONTACT_ME END -->

<style>
  @import "../styles/contact_me.css";
</style>
